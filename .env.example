# OceanGuard Environment Configuration (SIH26143)

# =============================================================================
# 1. Database Configuration (Supabase Cloud PostGIS or Local PostgreSQL)
# =============================================================================
# Option A: Supabase Cloud PostGIS Connection String (Recommended)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Direct Local PostGIS (Fallback)
# DATABASE_URL=postgresql://oceanguard:oceanguard123@localhost:5432/oceanguard_db

# Supabase API Keys (Optional / Frontend Client)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
